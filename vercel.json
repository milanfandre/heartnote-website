{
  "rewrites": [
    {
      "source": "/gift/:id",
      "destination": "/api/gift?id=:id"
    },
    {
      "source": "/lyrics/:id",
      "destination": "/api/lyrics?id=:id"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/lp",
      "destination": "/funnel.html"
    },
    {
      "source": "/lp/birthday-milestone",
      "destination": "/lp-birthday-milestone.html"
    },
    {
      "source": "/lp/birthday",
      "destination": "/lp-birthday-milestone.html"
    },
    {
      "source": "/lp/anniversary",
      "destination": "/lp-anniversary.html"
    },
    {
      "source": "/lp/faith",
      "destination": "/lp-faith.html"
    },
    {
      "source": "/deliver",
      "destination": "/deliver.html"
    },
    {
      "source": "/v1",
      "destination": "/v1.html"
    },
    {
      "source": "/v3",
      "destination": "/v3.html"
    },
    {
      "source": "/v3-order",
      "destination": "/v3-order.html"
    },
    {
      "source": "/hear/:token",
      "destination": "/api/gift?hear=:token"
    },
    {
      "source": "/preview/:token",
      "destination": "/api/gift?preview=:token"
    },
    {
      "source": "/unsubscribe/:token",
      "destination": "/api/gift?unsub=:token"
    }
  ],
  "redirects": [
    {
      "source": "/v2",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/v2-order",
      "destination": "/v3-order",
      "permanent": false
    },
    {
      "source": "/v2.html",
      "destination": "/v3",
      "permanent": false
    }
  ]
}
