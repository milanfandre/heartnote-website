{
  "rewrites": [
    {
      "source": "/gift/:id",
      "destination": "/api/gift?id=:id"
    },
    {
      "source": "/lyrics/:id",
      "destination": "/api/lyrics?id=:id"
    },
    {
      "source": "/lp",
      "destination": "/funnel"
    },
    {
      "source": "/lp/birthday-milestone",
      "destination": "/lp-birthday-milestone"
    },
    {
      "source": "/lp/birthday",
      "destination": "/lp-birthday-milestone"
    },
    {
      "source": "/lp/anniversary",
      "destination": "/lp-anniversary"
    },
    {
      "source": "/lp/faith",
      "destination": "/lp-faith"
    },
    {
      "source": "/unsubscribe/:token",
      "destination": "/api/gift?unsub=:token"
    }
  ],
  "redirects": [
    {
      "source": "/v2",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/v2.html",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/v3-order",
      "destination": "/order",
      "permanent": false
    },
    {
      "source": "/v2-order",
      "destination": "/order",
      "permanent": false
    }
  ],
  "functions": {
    "api/track.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true
}
